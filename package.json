{
  "name": "@omega-pcf/01-hilbert-polya",
  "version": "1.6.1",
  "description": "The Hilbert--Pólya Operator and the Primitive Structure of the Complex Plane: Between F1, String Theory, and Ancient Geometry",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "generate:figures": "uv run python scripts/figures/main.py",
    "generate:figures:list": "uv run python scripts/figures/main.py --list",
    "generate:zenodo": "pnpm exec tsx scripts/generate-zenodo.ts",
    "verify:py": "uv run python tests/verify_t_star.py",
    "verify:lean": "cd lean && lake build",
    "verify": "pnpm run verify:py && pnpm run verify:lean",
    "build": "pnpm exec tsx scripts/build.ts",
    "build:full": "pnpm run generate:figures && pnpm run build",
    "release": "dotenv -e .env -- release-it",
    "release:dry-run": "pnpm run build:full && dotenv -e .env -- release-it --dry-run --no-git.requireCleanWorkingDir"
  },
  "packageManager": "pnpm@9.0.0",
  "private": true,
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@release-it/bumper": "^7.0.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "^20.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-commits-parser": "^6.4.0",
    "dotenv-cli": "^11.0.0",
    "release-it": "^19.2.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "yaml": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omega-pcf/01-hilbert-polya.git"
  },
  "keywords": [
    "Riemann hypothesis",
    "Hilbert--Pólya conjecture",
    "L-functions",
    "Self-adjoint operators",
    "Random matrix theory",
    "Zeta function zeros",
    "Mersenne primes",
    "Modular spaces"
  ],
  "license": "CC-BY-4.0"
}
